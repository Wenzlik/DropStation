<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <!--
        Explicitly declares the localizations DropStation ships. The
        actual translations live in the `Localizable.xcstrings` String
        Catalog (English source + Czech). Listing them here ensures iOS
        offers Czech under Settings → DropStation → Language and loads
        the compiled `cs.lproj` strings, independent of how the build
        system derives known regions.
    -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>cs</string>
    </array>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>DropStation</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!--
        iPad-specific orientation list. With `TARGETED_DEVICE_FAMILY = "1,2"`
        the app supports iPad and is therefore subject to iPad multitasking
        rules: App Store Connect rejects builds (ITMS-90474) unless the iPad
        orientation set covers all four orientations, including
        PortraitUpsideDown. The iPhone array above intentionally omits
        PortraitUpsideDown — Face ID phones don't benefit from it and Apple
        only requires the four-way set on iPad.
    -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>magnet</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>magnet</string>
            </array>
        </dict>
    </array>
    <!--
        App Transport Security. Narrowed from the previous blanket
        `NSAllowsArbitraryLoads = true` now that self-signed
        certificates are handled explicitly:

          - Self-signed HTTPS (the DSM default) is accepted by the
            ServerTrustCoordinator URLSession delegate after the
            user pins the certificate. The delegate's
            `.useCredential` overrides ATS's cert-chain requirement,
            so full ATS can stay on for HTTPS — no blanket
            arbitrary-loads exception needed.
          - Cleartext HTTP to a LAN NAS (http:// on a .local /
            RFC 1918 host — DSM with HTTPS disabled) is still
            allowed via `NSAllowsLocalNetworking`, which is the
            App-Review-preferred narrow exception rather than
            allowing insecure loads to *any* host.

        Net effect vs. the old blanket flag: HTTPS (valid or
        self-signed-and-pinned) works everywhere; cleartext HTTP
        works on the local network only. Cleartext HTTP to a
        remote/public host is no longer allowed — it's insecure and
        rare (remote access is virtually always HTTPS via DDNS).
        If an internal tester reports a connection failure on an
        exotic setup, the fallback is to temporarily re-add
        `NSAllowsArbitraryLoads`.
    -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!--
        Required on iOS 14+ before iOS will allow connections to RFC 1918
        / .local addresses. Without this key, iOS silently blocks reaching
        a Synology NAS on the user's LAN and the login spinner hangs
        forever with no surfaced error. The string is shown verbatim in
        the system permission prompt the first time we try to reach the
        NAS.
    -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>DropStation connects to your Synology NAS on your home or office network to manage your downloads.</string>
    <!--
        Declares that DropStation only uses HTTPS/TLS provided by iOS
        (URLSession + the system TLS stack) and therefore qualifies for
        the standard "uses exempt encryption" exemption. With this key
        set, App Store Connect skips the Export Compliance questionnaire
        on every TestFlight / App Store upload.
    -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
